# Credentials for the end-to-end suite (npm run test:e2e).
# Nothing in this repo loads .env — export first:  set -a; . ./.env; set +a
#
# A Sentry auth token. The sandbox lifecycle (creating and deleting
# `e2e-sandbox-*` projects) needs org:write, project:write and event:write
# scopes; the read paths work with read scopes alone.
SENTRY_API_KEY=

# Optional. Without it the suite resolves the organization itself and
# requires the token to see exactly one.
SENTRY_ORG=

# Optional. Defaults to https://sentry.io/api/0 (self-hosted: your API root).
SENTRY_HOST=
